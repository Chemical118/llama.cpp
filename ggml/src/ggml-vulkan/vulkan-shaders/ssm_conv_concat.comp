#version 450

#extension GL_EXT_control_flow_attributes : require

#include "types.glsl"

// ssm_conv whose input is concat(state, x) along the token axis, without materializing the concat.
// Column j of the concat is state[j] for j < ncs, and token j - ncs of x after that.

layout(constant_id = 0) const uint BLOCK_SIZE = 32;
layout(constant_id = 1) const uint TOKENS_PER_WG = 16;
layout(constant_id = 2) const bool APPLY_BIAS = false;
layout(constant_id = 3) const bool APPLY_SILU = false;

layout(local_size_x_id = 0, local_size_y_id = 1, local_size_z = 1) in;

layout(binding = 0) readonly buffer State { float state[]; };
layout(binding = 1) readonly buffer Src0 { float src0[]; };
layout(binding = 2) readonly buffer Src1 { float src1[]; };
layout(binding = 3) readonly buffer Bias { float bias[]; };
layout(binding = 4) buffer Dst { float dst[]; };

// offsets and strides are in elements
layout(push_constant) uniform PushConstants {
    uint st_off; uint st_nb1; uint st_nb2;
    uint x_off; uint x_nb0; uint x_nb1; uint x_nb2;
    uint k_off; uint k_nb1;
    uint b_off;
    uint d_off; uint d_nb1; uint d_nb2;
    uint nc; uint ncs; uint nr; uint n_t; uint n_s;
};

float tap(const uint st_base, const uint x_base, const uint j) {
    if (j < ncs) {
        return state[st_base + j];
    }
    return src0[x_base + (j - ncs) * x_nb0];
}

void main() {
    const uint i1 = gl_GlobalInvocationID.x;
    const uint i2 = gl_WorkGroupID.y * TOKENS_PER_WG + gl_LocalInvocationID.y;
    const uint i3 = gl_WorkGroupID.z;

    if (i1 >= nr || i2 >= n_t || i3 >= n_s) {
        return;
    }

    const uint st_base = st_off + i3 * st_nb2 + i1 * st_nb1;
    const uint x_base  = x_off + i3 * x_nb2 + i1 * x_nb1;
    const uint k_base  = k_off + i1 * k_nb1;

    float sum = 0.0;

    if (nc == 4) {
        sum = dot(
            vec4(tap(st_base, x_base, i2), tap(st_base, x_base, i2 + 1), tap(st_base, x_base, i2 + 2), tap(st_base, x_base, i2 + 3)),
            vec4(src1[k_base], src1[k_base + 1], src1[k_base + 2], src1[k_base + 3])
        );
    } else {
        [[unroll]] for (uint i0 = 0; i0 < nc; i0++) {
            sum += tap(st_base, x_base, i2 + i0) * src1[k_base + i0];
        }
    }

    if (APPLY_BIAS) {
        sum += bias[b_off + i1];
    }
    if (APPLY_SILU) {
        sum = sum / (1.0f + exp(-sum));
    }

    dst[d_off + i3 * d_nb2 + i2 * d_nb1 + i1] = sum;
}
